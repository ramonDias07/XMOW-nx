+// ---- xmow 1031: the colour research dumps (pesquisa-cor-teste32.md items 3 and 4)
+
+bool RenderDk::VolcadoPsListado(uint32_t numero) const {
+  if (REXCVAR_GET(xmow_dk_volcado_ps) > 0 && numero == uint32_t(REXCVAR_GET(xmow_dk_volcado_ps))) {
+    return true;
+  }
+  const std::string& lista = REXCVAR_GET(xmow_dk_volcado_ps_lista);
+  uint32_t v = 0;
+  bool hay = false;
+  for (size_t i = 0; i <= lista.size(); ++i) {
+    const char ch = i < lista.size() ? lista[i] : ',';
+    if (ch >= '0' && ch <= '9') {
+      v = v * 10 + uint32_t(ch - '0');
+      hay = true;
+    } else {
+      if (hay && v == numero) return true;
+      v = 0;
+      hay = false;
+    }
+  }
+  return false;
+}
+
+// The textures the draw's PS samples, as it samples them now: each one copied into the dump (priority, raw .bin too),
+// unless that very image (serie and version) is already an entry of this dump.
+void RenderDk::VolcarEntradasPs(const uint32_t* r, const EntradaShader& ps, const char* motivo) {
+  static constexpr const char* kEtiquetas[16] = {"ps_s0", "ps_s1", "ps_s2",  "ps_s3",  "ps_s4",  "ps_s5",
+                                                 "ps_s6", "ps_s7", "ps_s8",  "ps_s9",  "ps_s10", "ps_s11",
+                                                 "ps_s12", "ps_s13", "ps_s14", "ps_s15"};
+  REXLOG_INFO("[xmow dump] inputs of PS n{} ({}), draw {} of the frame, RT0 info {:08X} pitch {} blend {:08X}",
+              ps.numero, motivo, dibujados_ - dibujos_inicio_fotograma_, r[gr::XE_GPU_REG_RB_COLOR_INFO],
+              r[gr::XE_GPU_REG_RB_SURFACE_INFO] & 0x3FFF, r[gr::XE_GPU_REG_RB_BLENDCONTROL0]);
+  for (const SamplerShader& sampler : ps.samplers) {
+    if (sampler.registro >= 16) {
+      continue;
+    }
+    const uint32_t* fetch = r + kRegFetch + uint32_t(sampler.registro) * 6;
+    const uint32_t base_t = ((fetch[1] >> 12) << 12) & 0x1FFFFFFF;
+    const ImagenDk* imagen = TexturaResuelta(base_t);
+    const char* origen = "resolved";
+    if (!imagen) {
+      const CacheFetch& cache = cache_fetch_[ClaveFetch(fetch) & (cache_fetch_.size() - 1)];
+      if (cache.textura && std::memcmp(cache.fetch.data(), fetch, sizeof(cache.fetch)) == 0) {
+        imagen = &cache.textura->imagen;
+        origen = "game texture";
+      }
+    }
+    const uint32_t w = (fetch[2] & 0x1FFF) + 1, hh = ((fetch[2] >> 13) & 0x1FFF) + 1;
+    const std::string datos_fetch =
+        fmt::format("fmt {} {}x{} signs {:02X} swizzle {:03X} exp_adjust {}", fetch[1] & 0x3F, w, hh,
+                    (fetch[0] >> 2) & 0xFF, (fetch[3] >> 1) & 0xFFF, int32_t(fetch[3] << 13) >> 26);
+    if (!imagen) {
+      REXLOG_INFO("[xmow dump]   PS n{} s{} {:08X} {}: no image, NOT dumped", ps.numero, sampler.registro, base_t,
+                  datos_fetch);
+      continue;
+    }
+    const auto ya = volcado_imagenes_.find(imagen->serie ^ (imagen->version * 0x9E3779B97F4A7C15ull));
+    if (ya != volcado_imagenes_.end()) {
+      REXLOG_INFO("[xmow dump]   PS n{} s{} {:08X} {} ({} {}x{}): the same image as dump entry {:02} (not copied again)",
+                  ps.numero, sampler.registro, base_t, datos_fetch, origen, imagen->ancho, imagen->alto, ya->second);
+      continue;
+    }
+    // xmow 1026: priority dump (the block's reserve), and only the rows the fetch constant says (a resolved target is
+    // pitch tall: 1280x1280 for a 1280x720 picture). Float/HDR images also get the "_clamp01" file (TerminarVolcado).
+    const bool es_2d = ((fetch[5] >> 9) & 0x3) == uint32_t(xenos::DataDimension::k2DOrStacked);
+    const uint32_t alto_fetch = es_2d ? hh : 0;
+    const uint32_t alto_volcado = alto_fetch >= 8 && alto_fetch < imagen->alto ? alto_fetch : 0;
+    const uint32_t entrada = uint32_t(volcado_.size());
+    const bool hecho = VolcarResuelta(*imagen, base_t, fetch[1] & 0x3F, kEtiquetas[sampler.registro], alto_volcado, true);
+    REXLOG_INFO("[xmow dump]   PS n{} s{} {:08X} {} ({} {}x{}, rows written {}): {}", ps.numero, sampler.registro,
+                base_t, datos_fetch, origen, imagen->ancho, imagen->alto, alto_volcado ? alto_volcado : imagen->alto,
+                hecho ? fmt::format("dump entry {:02}", entrada)
+                      : std::string(volcado_motivo_ ? volcado_motivo_ : "NOT dumped"));
+  }
+}
+
+// One line per draw of the passes the colour research needs: into EDRAM 2D0 with depth 5A0 (the half-resolution
+// translucency) or at a pitch other than 1280, into 658 (DOF), every full-screen pass and the listed PS.
+void RenderDk::LogDibujoVolcado(const PeticionDibujo& p, const EntradaShader* ps, uint32_t pitch, uint32_t cuenta) {
+  const int32_t maximo = REXCVAR_GET(xmow_dk_volcado_lineas);
+  if (maximo <= 0 || volcado_lineas_dibujo_ >= uint32_t(maximo)) {
+    return;
+  }
+  const uint32_t* r = p.registros;
+  const uint32_t c0 = r[gr::XE_GPU_REG_RB_COLOR_INFO], z = r[gr::XE_GPU_REG_RB_DEPTH_INFO];
+  // Colour draws only (the shadow and depth passes would use the budget up).
+  // EDRAM 2D0 in another format than the 7e3 scene (test 32: k_2_10_10_10 there, 10 draws a frame, kept as a separate
+  // image with no conversion of the 7e3 bits) is logged too.
+  const bool interesante = ps && (((c0 & 0xFFF) == 0x2D0 &&
+                                   ((z & 0xFFF) == 0x5A0 || pitch != 1280 || ((c0 >> 16) & 0xF) != 3)) ||
+                                  (c0 & 0xFFF) == 0x658 || cuenta <= 6 || VolcadoPsListado(ps->numero));
+  if (!interesante) {
+    return;
+  }
+  ++volcado_lineas_dibujo_;
+  std::string samplers;
+  if (ps) {
+    for (const SamplerShader& sampler : ps->samplers) {
+      if (sampler.registro >= 16) continue;
+      const uint32_t* fetch = r + kRegFetch + uint32_t(sampler.registro) * 6;
+      samplers += fmt::format(" s{} {:08X} {}x{} fmt {}", sampler.registro, ((fetch[1] >> 12) << 12) & 0x1FFFFFFF,
+                              (fetch[2] & 0x1FFF) + 1, ((fetch[2] >> 13) & 0x1FFF) + 1, fetch[1] & 0x3F);
+    }
+  }
+  REXLOG_INFO("[xmow dump] draw {} VS n{} PS {} prim {} count {}: pitch {} msaa {} mode {}; RT0 {:08X} RT1 {:08X} RT2 "
+              "{:08X} RT3 {:08X} depth {:08X}; blend {:08X} {:08X} {:08X} {:08X} color control {:08X} color mask {:08X} "
+              "depth control {:08X} blend color {:08X}{}{}",
+              dibujados_ - dibujos_inicio_fotograma_, p.vs->numero, ps ? fmt::format("n{}", ps->numero) : std::string("-"),
+              r[gr::XE_GPU_REG_VGT_DRAW_INITIATOR] & 0x3F, cuenta, pitch, (r[gr::XE_GPU_REG_RB_SURFACE_INFO] >> 16) & 0x3,
+              r[gr::XE_GPU_REG_RB_MODECONTROL] & 0x7, c0, r[gr::XE_GPU_REG_RB_COLOR1_INFO],
+              r[gr::XE_GPU_REG_RB_COLOR2_INFO], r[gr::XE_GPU_REG_RB_COLOR3_INFO], z, r[gr::XE_GPU_REG_RB_BLENDCONTROL0],
+              r[gr::XE_GPU_REG_RB_BLENDCONTROL1], r[gr::XE_GPU_REG_RB_BLENDCONTROL2], r[gr::XE_GPU_REG_RB_BLENDCONTROL3],
+              r[gr::XE_GPU_REG_RB_COLORCONTROL], r[gr::XE_GPU_REG_RB_COLOR_MASK], r[gr::XE_GPU_REG_RB_DEPTHCONTROL],
+              r[gr::XE_GPU_REG_RB_BLEND_RED], samplers.empty() ? "" : ";", samplers);
+}
+
+// What the stuck job (and the one before it) drew for the first time: a new shader pair or texture.
+// xmow 1034: the line destinos.cpp formatted at each resolve until 0.1.27, now from its numbers.
+std::string RenderDk::TextoResolve(const NovedadResolve& r) {
+  return fmt::format("resolve ({},{})-({},{}) de {:03X} f{} {}x{} a {:08X} ({}x{}) en ({},{}) {}x{}{}", r.x0, r.y0, r.x1,
+                     r.y1, r.info, r.formato, r.destino_ancho, r.destino_alto, r.base, r.ancho_resuelta,
+                     r.alto_resuelta, r.dx, r.dy, r.ancho, r.alto, r.sufijo);
+}
+
+void RenderDk::VolcarNovedades(uint64_t trabajo) {
+  size_t n = 0;
+  for (size_t i = 0; i < novedades_.size(); ++i) {
+    const Novedad& nv = novedades_[(novedades_pos_ + i) % novedades_.size()];
+    const uint64_t t = nv.trabajo;
+    if (t + 1 >= trabajo && t <= trabajo) {
+      REXLOG_WARN("[deko3d] GPU atascada en el trabajo {}: nuevo en el trabajo {}: {}", trabajo, t,
+                  nv.es_resolve ? TextoResolve(nv.resolve) : nv.linea);
+      ++n;
+    }
+  }
+  REXLOG_WARN("[deko3d] GPU atascada en el trabajo {}: {} dibujos con algo nuevo en el y el anterior", trabajo, n);
+}
+
 }  // namespace rex::x360
