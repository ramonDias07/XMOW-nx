+
+// ---- Background writes to the SD card (EncolarEscrituraSd)
+
+namespace {
+// xmow 1031: writes queued or running (EscriturasSdPendientes).
+std::atomic<uint32_t> g_escrituras_sd{0};
+}  // namespace
+
+uint32_t EscriturasSdPendientes() { return g_escrituras_sd.load(std::memory_order_acquire); }
+
+bool EscribirArchivoEnTrozos(const std::filesystem::path& ruta, const void* datos, size_t bytes, bool anadir) {
+  FILE* f = std::fopen(ruta.string().c_str(), anadir ? "ab" : "wb");
+  if (!f) {
+    return false;
+  }
+  const size_t trozo = size_t(std::max(REXCVAR_GET(xmow_volcado_trozo_kb), 0)) << 10;
+  const int32_t pausa_ms = REXCVAR_GET(xmow_volcado_pausa_ms);
+  const uint8_t* p = static_cast<const uint8_t*>(datos);
+  bool ok = true;
+  // One fwrite per piece, then the stdio buffer is pushed out (fflush) so each piece is its own SD request, and a pause
+  // lets the game's reads in. Small writes are still avoided: 10-50 ms each on the card.
+  for (size_t hecho = 0; hecho < bytes && ok;) {
+    const size_t n = trozo ? std::min(trozo, bytes - hecho) : bytes - hecho;
+    ok = std::fwrite(p + hecho, 1, n, f) == n;
+    hecho += n;
+    if (trozo && hecho < bytes) {
+      std::fflush(f);
+      if (pausa_ms > 0) {
+        rex::thread::Sleep(std::chrono::milliseconds(pausa_ms));
+      }
+    }
+  }
+  ok = std::fclose(f) == 0 && ok;
+  return ok;
+}
+
+void EncolarEscrituraSd(std::function<void()> escritura) {
+  struct Escritor {
+    std::mutex candado;
+    std::condition_variable hay;
+    std::deque<std::function<void()>> cola;
+    std::unique_ptr<rex::thread::Thread> hilo;
+  };
+  static Escritor* e = new Escritor();  // never destroyed: its thread lives as long as the process
+  g_escrituras_sd.fetch_add(1, std::memory_order_acq_rel);  // xmow 1031
+  {
+    std::lock_guard<std::mutex> l(e->candado);
+    e->cola.push_back(std::move(escritura));
+    if (!e->hilo) {
+      e->hilo = rex::thread::Thread::Create({}, [] {
+#if REX_PLATFORM_SWITCH
+        // xmow 1031: the time-sliced band (as the guest threads), below the ring, audio and presentation: the writer
+        // only gets the CPU when they leave it.
+        RexSwitchSetCurrentThreadPriority(REX_SWITCH_PRIO_GUEST);
+#endif
+        for (;;) {
+          std::function<void()> tarea;
+          {
+            std::unique_lock<std::mutex> l(e->candado);
+            e->hay.wait(l, [] { return !e->cola.empty(); });
+            tarea = std::move(e->cola.front());
+            e->cola.pop_front();
+          }
+          tarea();
+          tarea = nullptr;  // its buffers go before the count says the write is done
+          g_escrituras_sd.fetch_sub(1, std::memory_order_acq_rel);
+        }
+      });
+      if (!e->hilo) {
+        // No thread: done here, as before.
+        auto tarea = std::move(e->cola.back());
+        e->cola.pop_back();
+        tarea();
+        g_escrituras_sd.fetch_sub(1, std::memory_order_acq_rel);
+        return;
+      }
+    }
+  }
+  e->hay.notify_one();
+}
+
 }  // namespace rex::x360
