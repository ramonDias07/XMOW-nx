diff --git a/include/rex/input/filtro_mando.h b/include/rex/input/filtro_mando.h
new file mode 100644
index 0000000..8a161cb
--- /dev/null
+++ b/include/rex/input/filtro_mando.h
@@ -0,0 +1,16 @@
+// A game's own use of the controller before the game sees it (an options menu opened with a button combination). The
+// Switch input driver calls the filter on every poll of a connected controller with the buttons held (HidNpadButton_*
+// bits) and the controller's slot; if it returns true the game sees that controller idle (no buttons, centered
+// sticks) for that poll.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace rex::input {
+
+using FiltroMando = bool (*)(size_t ranura, uint64_t botones);
+void FijarFiltroMando(FiltroMando filtro);
+
+}  // namespace rex::input
diff --git a/include/rex/ui/superposicion.h b/include/rex/ui/superposicion.h
new file mode 100644
index 0000000..5561c4a
--- /dev/null
+++ b/include/rex/ui/superposicion.h
@@ -0,0 +1,22 @@
+// A few lines of text the deko3d presenter paints over the guest output (a game's options menu), centered in a black
+// box with the FPS counter's dot font: no ImGui and no UI drawer, so presentation stays on the game's thread (a UI
+// drawer moves every paint to the UI thread; Dead Space 3's screen went black that way). Charset: letters (lower case
+// draws as upper case, except 'x', which stays the times sign), digits, space and . : / ( ) - + > ! , % ' =.
+// Thread-safe; an empty list takes it away.
+
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace rex::ui {
+
+// Up to 16 lines of 44 columns.
+void FijarSuperposicion(std::vector<std::string> lineas);
+
+// A marquee line under the menu's lines (shown only while the menu is). Up to 44 columns it stays still; longer, it
+// scrolls one character every 6 presented frames (the text, three spaces, the text again); new text restarts the
+// scroll. An empty string takes it away.
+void FijarLetreiro(std::string texto);
+
+}  // namespace rex::ui
