+              borrados_clase[1], borrados_clase[2], double(px_borrados) / 1e6, por_tipo[kOpBarrera].ns / 1e6,
+              por_tipo[kOpBarrera].n, por_tipo[kOpResolve].ns / 1e6, por_tipo[kOpResolve].n, fuera / 1e6,
+              perfil_fotograma_, ns_lapso / 1e6, ns_dibujos / 1e6, ns_repeticiones / 1e6, fuera / 1e6,
+              std::max(0.0, ns_lapso - ns_dibujos - ns_repeticiones - fuera) / 1e6, sin_medir);
+  std::sort(lista.begin(), lista.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+  for (size_t k = 0; k < std::min<size_t>(lista.size(), 10); ++k) {
+    const OpPerfil& o = perfil_ops_[lista[k].second];
+    std::string que;
+    if (o.tipo == kOpBarrera) {
+      que = fmt::format("{} ({})", kNombresBarrera[std::min<uint32_t>(o.causa, kCausasBarrera - 1)],
+                        kNombresModoBarrera[std::min<uint32_t>(o.formato, 4)]);
+    } else if (o.tipo == kOpBorrado) {
+      que = fmt::format("{} {} {}, {}x{}, base {:X} formato {}", kNombresClaseBorrado[std::min<uint32_t>(o.clase & 0xF, 2)],
