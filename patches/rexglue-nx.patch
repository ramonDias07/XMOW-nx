+bool RenderDk::ExisteDestino(uint32_t base, uint32_t formato, uint32_t pitch, bool profundidad) const {
+  if (!profundidad) {
+    formato = formato == 12 ? 3 : formato == 10 ? 2 : formato;  // as DestinoColor
+  }
+  const uint64_t clave = (uint64_t(base) << 20) | (uint64_t(formato) << 16) | pitch;
+  return profundidad ? profundidades_.count(clave) != 0 : destinos_.count(clave) != 0;
+}
