+    const uint32_t cabecera[2] = {kMagiaPrecargaDksh, uint32_t(claves_mapa_.size())};
+    std::memcpy(datos.data(), cabecera, 8);
+    std::memcpy(datos.data() + 8, claves_mapa_.data(), claves_mapa_.size() * 16);
+    EncolarEscrituraSd([datos = std::move(datos), carpeta, ruta = carpeta / (mapa_ + ".dksh")] {
