+  if (const auto it = resueltas_.find(direccion); it != resueltas_.end()) {
+    it->second.escrita = false;  // until the next resolve to it
+  }
+  for (auto o = resueltas_otras_.lower_bound(std::make_tuple(direccion, 0u, 0u, 0u));
+       o != resueltas_otras_.end() && std::get<0>(o->first) == direccion; ++o) {
+    o->second.escrita = false;
+  }
+  resolves_vistos_.erase(direccion);  // the next resolve there is not skipped as a repeat
+  ++generacion_texturas_;             // the per-fetch cache may name the resolved image
