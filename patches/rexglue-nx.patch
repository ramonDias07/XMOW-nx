+  }
+}
+
+struct ColorMenu {
+  uint8_t r, g, b;
+};
+constexpr ColorMenu kMenuFondo = {10, 25, 13};
+constexpr ColorMenu kMenuBlanco = {0xFF, 0xFF, 0xFF};
+constexpr ColorMenu kMenuVerde = {0xA5, 0xFF, 0x86};     // the title and the selected line
+constexpr ColorMenu kMenuApagado = {0x78, 0x80, 0x78};   // after '\x02': a locked achievement
+constexpr ColorMenu kMenuPequeno = {0xB4, 0xBC, 0xB4};   // the small font ('\x01')
+
+// Rows [y0, y0 + alto) of the box at the double resolution, kMenuAnchoHd texels each; writes outside are dropped.
+struct LienzoMenu {
+  uint8_t* texeles;
+  uint32_t y0, alto;
+  uint8_t* Texel(uint32_t x, uint32_t y) const {
+    if (x >= kMenuAnchoHd || y < y0 || y >= y0 + alto) return nullptr;
+    return texeles + (size_t(y - y0) * kMenuAnchoHd + x) * 4;
+  }
+  void Fondo() const {
+    for (size_t i = 0; i < size_t(kMenuAnchoHd) * alto; ++i) {
+      uint8_t* t = texeles + i * 4;
+      t[0] = kMenuFondo.r;
+      t[1] = kMenuFondo.g;
+      t[2] = kMenuFondo.b;
+      t[3] = 0xFF;
+    }
+  }
+};
+
+// A glyph whose top left is (x, y), `punto` texels per dot.
+void PintarGlifoMenu(const LienzoMenu& l, char c, uint32_t x, uint32_t y, uint32_t punto, ColorMenu color) {
+  const uint8_t* glifo = GlifoMenu(c);
+  for (uint32_t fila = 0; fila < 7; ++fila) {
+    for (uint32_t columna = 0; columna < 5; ++columna) {
+      if (!((glifo[fila] >> (4 - columna)) & 1)) continue;
+      for (uint32_t dy = 0; dy < punto; ++dy) {
+        for (uint32_t dx = 0; dx < punto; ++dx) {
+          if (uint8_t* t = l.Texel(x + columna * punto + dx, y + fila * punto + dy)) {
+            t[0] = color.r;
+            t[1] = color.g;
+            t[2] = color.b;
+          }
+        }
+      }
+    }
+  }
+}
+
+// A small run: up to two rows of the half-size font from (x0, y0), each broken at '\n' or at the last space that fits.
+// Returns the right edge of what it drew (x0 when nothing).
+uint32_t PintarPequenoMenu(const LienzoMenu& l, std::string_view texto, uint32_t x0, uint32_t y0, ColorMenu color) {
+  if (x0 + kMenuCeldaHd >= kMenuAnchoHd) return x0;
+  const size_t capacidad = (kMenuAnchoHd - kMenuCeldaHd - x0) / 6;
+  uint32_t derecha = x0;
+  for (uint32_t fila = 0; fila < 2 && !texto.empty(); ++fila) {
+    while (!texto.empty() && (texto.front() == ' ' || texto.front() == '\n')) texto.remove_prefix(1);
+    size_t corte = std::min(texto.find('\n'), texto.size());
+    size_t siguiente = corte + 1;  // past the '\n'
+    if (corte > capacidad) {
+      const size_t espacio = texto.substr(0, capacidad + 1).rfind(' ');
+      corte = espacio != std::string_view::npos && espacio > 0 ? espacio : capacidad;
+      siguiente = corte;
+    }
+    for (size_t i = 0; i < corte; ++i) {
+      PintarGlifoMenu(l, texto[i], x0 + uint32_t(i) * 6, y0 + fila * 9, 1, color);
+    }
+    if (corte) derecha = std::max(derecha, x0 + uint32_t(corte) * 6);
+    texto.remove_prefix(std::min(siguiente, texto.size()));
+  }
+  return derecha;
+}
+
+// Line n: the normal font, '\x02' (blank; dim from there on) and '\x01' (the rest in the small font). Returns the right
+// edge of what it holds.
+uint32_t PintarLineaMenu(const LienzoMenu& l, const std::string& linea, uint32_t n) {
+  const bool destacada = n == 0 || (n < kMenuFilas && linea.starts_with('>'));
+  ColorMenu color = destacada ? kMenuVerde : kMenuBlanco;
+  bool apagada = false;
+  uint32_t derecha = 0;
+  for (uint32_t i = 0; i < kMenuColumnas && i < linea.size(); ++i) {
+    const uint32_t x = (i + 1) * kMenuCeldaHd;
+    if (linea[i] == '\x02') {
+      color = kMenuApagado;
+      apagada = true;
+      continue;
+    }
+    if (linea[i] == '\x03') {
+      // 0.1.50, the big font: dots of 2x the normal ones, a character two columns wide; the next line must be empty.
+      for (size_t k = i + 1; k < linea.size(); ++k) {
+        const uint32_t xg = x + uint32_t(k - i - 1) * 2 * kMenuCeldaHd;
+        if (xg + 2 * kMenuCeldaHd > kMenuAnchoHd - kMenuCeldaHd) break;
+        if (linea[k] != ' ') derecha = std::max(derecha, xg + 2 * kMenuCeldaHd);
+        PintarGlifoMenu(l, linea[k], xg, n * kMenuLineaHd + 4, 2 * kMenuHd, color);
+      }
+      break;
+    }
+    if (linea[i] == '\x01') {
+      derecha = std::max(derecha, PintarPequenoMenu(l, std::string_view(linea).substr(i + 1), x,
+                                                    n * kMenuLineaHd + 9, apagada ? kMenuApagado : kMenuPequeno));
+      break;
+    }
+    if (linea[i] != ' ') derecha = std::max(derecha, x + kMenuCeldaHd);
+    PintarGlifoMenu(l, linea[i], x, n * kMenuLineaHd + 5 * kMenuHd, kMenuHd, color);
+  }
+  return derecha;
+}
+
+// An icon box-filtered to 16x16 or 32x32 and blended over the box (straight alpha). Returns its right edge (0: none).
+uint32_t PintarIconoMenu(const LienzoMenu& l, const rex::ui::IconoEnLinea& e) {
+  const rex::ui::IconoSuperposicion* icono = e.icono.get();
+  if (!icono || !icono->ancho || !icono->alto || icono->rgba.size() < size_t(icono->ancho) * icono->alto * 4) return 0;
+  const uint32_t lado = e.filas >= 2 ? std::min<uint32_t>(e.filas, 6) * 16 : 16;  // 0.1.50: up to 96 over 6 lines
+  const uint32_t x0 = (e.columna + 1) * kMenuCeldaHd + 2;
+  const uint32_t y0 = e.linea * kMenuLineaHd + (e.filas >= 2 ? 10 : 9);
+  const bool ampliar = icono->ancho < lado || icono->alto < lado;
+  for (uint32_t dy = 0; dy < lado; ++dy) {
+    if (ampliar) {
+      // A smaller source than the box: bilinear on premultiplied colour (non-integer scales stay smooth).
+      const float fy = std::clamp((float(dy) + 0.5f) * float(icono->alto) / float(lado) - 0.5f, 0.0f,
+                                  float(icono->alto - 1));
+      const uint32_t iy = uint32_t(fy), iy2 = std::min(iy + 1, icono->alto - 1);
+      const float wy = fy - float(iy);
+      for (uint32_t dx = 0; dx < lado; ++dx) {
+        uint8_t* t = l.Texel(x0 + dx, y0 + dy);
+        if (!t) continue;
+        const float fx = std::clamp((float(dx) + 0.5f) * float(icono->ancho) / float(lado) - 0.5f, 0.0f,
+                                    float(icono->ancho - 1));
+        const uint32_t ix = uint32_t(fx), ix2 = std::min(ix + 1, icono->ancho - 1);
+        const float wx = fx - float(ix);
+        float c[4] = {0, 0, 0, 0};  // premultiplied r, g, b (0-255) and alpha (0-1)
+        const uint32_t xs[4] = {ix, ix2, ix, ix2}, ys[4] = {iy, iy, iy2, iy2};
+        const float ws[4] = {(1 - wx) * (1 - wy), wx * (1 - wy), (1 - wx) * wy, wx * wy};
+        for (int k = 0; k < 4; ++k) {
+          const uint8_t* p = icono->rgba.data() + (size_t(ys[k]) * icono->ancho + xs[k]) * 4;
+          const float a = float(p[3]) / 255.0f;
+          c[0] += ws[k] * float(p[0]) * a;
+          c[1] += ws[k] * float(p[1]) * a;
+          c[2] += ws[k] * float(p[2]) * a;
+          c[3] += ws[k] * a;
+        }
+        if (c[3] <= 0.0f) continue;
+        if (e.gris) c[0] = c[1] = c[2] = (0.299f * c[0] + 0.587f * c[1] + 0.114f * c[2]) * 0.35f;
+        t[0] = uint8_t(std::min(255.0f, c[0] + float(t[0]) * (1 - c[3])));
+        t[1] = uint8_t(std::min(255.0f, c[1] + float(t[1]) * (1 - c[3])));
+        t[2] = uint8_t(std::min(255.0f, c[2] + float(t[2]) * (1 - c[3])));
+      }
+      continue;
+    }
+    const uint32_t sy0 = dy * icono->alto / lado;
+    const uint32_t sy1 = std::max(sy0 + 1, (dy + 1) * icono->alto / lado);
+    for (uint32_t dx = 0; dx < lado; ++dx) {
+      uint8_t* t = l.Texel(x0 + dx, y0 + dy);
+      if (!t) continue;
+      const uint32_t sx0 = dx * icono->ancho / lado;
+      const uint32_t sx1 = std::max(sx0 + 1, (dx + 1) * icono->ancho / lado);
+      uint32_t n = 0, r = 0, g = 0, b = 0, a = 0;
+      for (uint32_t sy = sy0; sy < sy1; ++sy) {
+        for (uint32_t sx = sx0; sx < sx1; ++sx) {
+          const uint8_t* p = icono->rgba.data() + (size_t(sy) * icono->ancho + sx) * 4;
+          r += uint32_t(p[0]) * p[3];
+          g += uint32_t(p[1]) * p[3];
+          b += uint32_t(p[2]) * p[3];
+          a += p[3];
+          ++n;
+        }
+      }
+      if (!a) continue;
+      // Premultiplied averages (0-255) and the coverage (0-1).
+      float cr = float(r) / float(255 * n), cg = float(g) / float(255 * n), cb = float(b) / float(255 * n);
+      const float alfa = float(a) / float(255 * n);
+      if (e.gris) cr = cg = cb = (0.299f * cr + 0.587f * cg + 0.114f * cb) * 0.35f;
+      t[0] = uint8_t(std::min(255.0f, cr + float(t[0]) * (1 - alfa)));
+      t[1] = uint8_t(std::min(255.0f, cg + float(t[1]) * (1 - alfa)));
+      t[2] = uint8_t(std::min(255.0f, cb + float(t[2]) * (1 - alfa)));
+    }
+  }
+  return x0 + lado;
+}
+
+// The lines and their icons over the background, with a character of margin. Returns the right edge of what it holds.
+uint32_t RasterizarMenu(const std::vector<std::string>& lineas, const std::vector<rex::ui::IconoEnLinea>& iconos,
+                        const LienzoMenu& l) {
+  l.Fondo();
+  uint32_t derecha = 0;
+  for (uint32_t n = 0; n < kMenuFilasTotal && n < lineas.size(); ++n) {
+    derecha = std::max(derecha, PintarLineaMenu(l, lineas[n], n));
+  }
+  for (const rex::ui::IconoEnLinea& e : iconos) {
+    if (e.linea < kMenuFilasTotal) derecha = std::max(derecha, PintarIconoMenu(l, e));
+  }
+  return derecha;
+}
