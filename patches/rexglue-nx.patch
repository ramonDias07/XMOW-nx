+const ImagenDk* RenderDk::TexturaResueltaVigente(uint32_t direccion, uint32_t ancho, uint32_t alto) {
+  const ImagenDk* const r = TexturaResuelta(direccion, ancho, alto);
+  if (!r || !REXCVAR_GET(xmow_dk_identidad_texturas) || (frontal_.pendiente && direccion == frontal_.base)) {
+    return r;
+  }
+  const auto s = sondas_resueltas_.find(direccion);
+  if (s == sondas_resueltas_.end() || s->second.fotograma == fotograma_) {
+    return r;
+  }
+  s->second.fotograma = fotograma_;
+  ++identidad_sondas_;
