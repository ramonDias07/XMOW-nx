+// xmow_dk_alto_por_retangulo. The old rule (the Vulkan path's ObtenerDestino) made every target pitch x max(720, pitch):
+// 1280x1280 for the 1280x720 scene, 560x720 for the shadow map drawn and resolved as 512x512. Its size is now what has
+// been asked for (the draw's scissor within its viewport, the resolve's or clear's rectangle): at least 720 rows when the
+// pitch is 720 or more (the scene's size before its first draw says it), and for narrower pitches the rectangle's own
+// width and height. Never more than the old rule's size: past it nothing changes. A target asked for more later grows
+// (CrecerDestino), so nothing is ever drawn outside it.
+void RenderDk::TamanoDestino(uint32_t pitch, uint32_t ancho_pedido, uint32_t alto_pedido, uint32_t& ancho,
+                             uint32_t& alto, uint32_t& ancho_maximo, uint32_t& alto_maximo) const {
+  ancho_maximo = pitch;
+  alto_maximo = std::min(kAltoMaximoDestino, std::max<uint32_t>(720, (pitch + 15) & ~15u));
+  ancho = ancho_maximo;
+  alto = alto_maximo;
+  if (!REXCVAR_GET(xmow_dk_alto_por_retangulo)) {
+    return;
+  }
+  const bool estrecho = pitch < 720;
+  if (estrecho && ancho_pedido) {
+    ancho = std::clamp<uint32_t>((ancho_pedido + 7) & ~7u, 8, ancho_maximo);
+  }
+  const uint32_t minimo = estrecho ? 16u : 720u;
+  if (alto_pedido) {
+    alto = std::clamp<uint32_t>((alto_pedido + 15) & ~15u, std::min(minimo, alto_maximo), alto_maximo);
+  } else if (!estrecho) {
+    alto = std::min(720u, alto_maximo);
+  }
+}
