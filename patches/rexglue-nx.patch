+// xmow 1032: the interval's samples, encoded (format at g_escritor_crudo) and handed to the title's SD writer. Runs on
+// this thread after the report, with no thread paused.
+void VolcarCrudo(const std::vector<size_t>& hilos, u64 inicio, u64 fin, u64 tick_freq) {
+  const EscritorCrudo escribir = g_escritor_crudo.load(std::memory_order_acquire);
+  const u64 tope = g_tope_crudo.load(std::memory_order_relaxed);
+  if (!escribir || !tope || !g_sample_count || !g_muestrear_pilas.load(std::memory_order_relaxed)) {
+    return;
+  }
+  if (g_bytes_crudos >= tope) {
+    if (!g_aviso_tope) {
+      g_aviso_tope = true;
+      if (FILE* f = std::fopen(ReportPath().c_str(), "a")) {
+        std::fprintf(f, "xmow 1032: raw sample dump stopped at its cap (%llu MB this boot)\n",
+                     (unsigned long long)(tope >> 20));
+        std::fclose(f);
+      }
+    }
+    return;
+  }
+  const u32 t = u32(hilos.size());
+  const u32 n = u32(g_sample_count);
+  const size_t cabecera = 4 + 4 + 8 * 5 + 4 + 4 + size_t(t) * 40;
+  size_t bytes = cabecera;
+  for (u32 i = 0; i < n; ++i) {
+    u32 fr = 0;
+    while (fr < kFrames && g_samples[i].frames[fr]) ++fr;
+    bytes += 16 + size_t(fr) * 4;
+  }
+  uint8_t* datos = static_cast<uint8_t*>(std::malloc(bytes));
+  if (!datos) {
+    return;
+  }
+  uint8_t* p = datos;
+  auto pon = [&p](const void* v, size_t k) {
+    std::memcpy(p, v, k);
+    p += k;
+  };
+  auto pon32 = [&pon](u32 v) { pon(&v, 4); };
+  auto pon64 = [&pon](u64 v) { pon(&v, 8); };
+  pon("XSP1", 4);
+  pon32(u32(cabecera));
+  pon64(g_base);
+  pon64(g_text_hi - g_base);
+  pon64(tick_freq);
+  pon64(inicio);
+  pon64(fin);
+  pon32(t);
+  pon32(n);
+  for (size_t i : hilos) {
+    const u16 slot = u16(i), cero = 0;
+    const float cpu = float(g_slots[i].cpu);
