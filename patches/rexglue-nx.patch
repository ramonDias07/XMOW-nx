diff --git a/include/rex/ui/superposicion.h b/include/rex/ui/superposicion.h
new file mode 100644
index 0000000..17a77f3
--- /dev/null
+++ b/include/rex/ui/superposicion.h
@@ -0,0 +1,65 @@
+// A few lines of text the deko3d presenter paints over the guest output (a game's options menu), centered in a black
+// box with the FPS counter's dot font: no ImGui and no UI drawer, so presentation stays on the game's thread (a UI
+// drawer moves every paint to the UI thread; Dead Space 3's screen went black that way). Upper-case letters, digits,
+// space and . : / ( ) - + > ! , x, plus % ' = (build 0.1.43); lower case letters draw as upper case (except 'x', the
+// times sign). Anything else is blank. The box holds 16 lines of 44 characters and, under them, the marquee line.
+// Thread-safe; an empty list takes it away.
+//
+// Build 0.1.47 (achievements with icons, console/RetroArch style). The box is rasterized at twice its old resolution
+// on the CPU (same size on screen), which allows, with no new shader:
+//  - '\x01' in a line: the rest of the line is drawn in the small font (half size, grey), starting at the column of the
+//    marker. A small run holds two rows inside the line (it wraps at a space, or at '\n'); about 76 characters per row
+//    from column 6.
+//  - '\x02' in a line: a blank cell; the rest of the line is drawn dim grey (a locked achievement).
+//  - icons (IconoEnLinea): an RGBA image composited into the box, 16x16 texels in one line or 32x32 over its line and
+//    the next, from character column `columna` (the caller leaves those columns blank).
+// Build 0.1.50: '\x03' in a line: the rest of the line is drawn in the big font (each dot 4x4 texels, a character is two
+//    columns wide and two lines tall: leave the next line empty); from the marker's column, 16 characters at most fit
+//    from column 11. Icons may be up to 6 lines (see IconoEnLinea::filas).
+// The notification (AvisarSuperposicion*) box is cropped to the width of its widest line, in the top-right corner.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace rex::ui {
+
+void FijarSuperposicion(std::vector<std::string> lineas);
+// Shows a short notification when the menu is closed. Empty lines clear it.
+void AvisarSuperposicion(std::vector<std::string> lineas);
+// The marquee line: one extra line at the bottom of the menu box. Up to 44 characters it stays still; longer, it scrolls
+// one character every ~6 presented frames (the text, three spaces, the text again). An empty string hides it. It is shown
+// with the menu (FijarSuperposicion), not with the notification (AvisarSuperposicion).
+void FijarLetreiro(std::string texto);
+
+// An icon: R8G8B8A8, straight alpha, `ancho` x `alto` texels (DecodificarIcono gives 32x32 at most).
+struct IconoSuperposicion {
+  uint32_t id = 0;  // the caller's key (an achievement's image id), only for logs
+  uint32_t ancho = 0, alto = 0;
+  std::vector<uint8_t> rgba;
+};
+using IconoCompartido = std::shared_ptr<const IconoSuperposicion>;
+
+struct IconoEnLinea {
+  uint32_t linea = 0;    // the line it starts on (0 = the first)
+  uint32_t columna = 0;  // the first character column it covers (16x16: two columns; 32x32: three)
+  uint32_t filas = 2;    // 1: 16x16 in its line; 2: 32x32 over its line and the next; n (up to 6): n*16 square texels
+                         // (6: 96x96, 8 character columns wide). A source smaller than that is scaled up bilinearly.
+  bool gris = false;     // drawn dark grey (luminance x 0.35): a locked achievement
+  IconoCompartido icono;  // null: nothing is drawn (the text-only layout)
+};
+
+// The menu with icons. FijarSuperposicion(lineas) is this with no icons.
+void FijarSuperposicionConIconos(std::vector<std::string> lineas, std::vector<IconoEnLinea> iconos);
+// The notification with one icon (a null icon: text only). AvisarSuperposicion(lineas) is this with no icon.
+void AvisarSuperposicionConIcono(std::vector<std::string> lineas, IconoEnLinea icono);
+// A PNG (an achievement image of the game's XDBF) decoded and box-filtered down to 32x32 at most. Null if it does not
+// decode.
+// `lado_maximo` (build 0.1.50, default 32) is the size it is reduced to: ask for 96 for an icon drawn over 6 lines.
+IconoCompartido DecodificarIcono(uint32_t id, const uint8_t* datos, size_t tamano, uint32_t lado_maximo = 32);
+
+}  // namespace rex::ui
