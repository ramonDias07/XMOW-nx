+    pon(&cero, 2);
+    pon(&cpu, 4);
+    char nombre[32] = {};
+    std::memcpy(nombre, g_slots[i].name, sizeof(nombre) - 1);
+    pon(nombre, 32);
+  }
+  for (u32 i = 0; i < n; ++i) {
+    const Sample& s = g_samples[i];
+    uint8_t fr = 0;
+    while (fr < kFrames && s.frames[fr]) ++fr;
+    const uint8_t flags = AfterSvc(s.pc) ? 1 : 0;
+    pon(&s.slot, 2);
+    pon(&fr, 1);
+    pon(&flags, 1);
+    pon32(s.tick > inicio ? u32(std::min<u64>((s.tick - inicio) * 1000000ULL / tick_freq, 0xFFFFFFFFULL)) : 0);
+    pon32(Desplazamiento(s.pc));
+    pon32(Desplazamiento(s.lr));
+    for (uint8_t k = 0; k < fr; ++k) pon32(Desplazamiento(s.frames[k]));
+  }
+  if (escribir(RawPath().c_str(), datos, bytes)) {
