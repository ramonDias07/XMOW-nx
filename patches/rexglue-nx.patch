+bool MismosIconos(const std::vector<IconoEnLinea>& a, const std::vector<IconoEnLinea>& b) {
+  if (a.size() != b.size()) return false;
+  for (size_t i = 0; i < a.size(); ++i) {
+    if (a[i].linea != b[i].linea || a[i].columna != b[i].columna || a[i].filas != b[i].filas ||
+        a[i].gris != b[i].gris || a[i].icono != b[i].icono) {
+      return false;
+    }
+  }
+  return true;
+}
+}  // namespace
+
+void FijarSuperposicion(std::vector<std::string> lineas) { FijarSuperposicionConIconos(std::move(lineas), {}); }
+
+void FijarSuperposicionConIconos(std::vector<std::string> lineas, std::vector<IconoEnLinea> iconos) {
+  auto& s = rex::deko3d::LaSuperposicion();
+  std::lock_guard<std::mutex> cerrojo(s.candado);
+  if (lineas == s.lineas && MismosIconos(iconos, s.iconos)) return;
+  s.lineas = std::move(lineas);
+  s.iconos = std::move(iconos);
+  ++s.version;
+}
+
+void AvisarSuperposicionConIcono(std::vector<std::string> lineas, IconoEnLinea icono) {
+  auto& s = rex::deko3d::LaSuperposicion();
+  std::lock_guard<std::mutex> cerrojo(s.candado);
+  s.aviso = std::move(lineas);
+  s.iconos_aviso.clear();
+  if (icono.icono) s.iconos_aviso.push_back(std::move(icono));
+  s.vence_aviso = std::chrono::steady_clock::now() + std::chrono::seconds(4);
+  ++s.version;
+}
+
+IconoCompartido DecodificarIcono(uint32_t id, const uint8_t* datos, size_t tamano, uint32_t lado_maximo) {
+  int ancho = 0, alto = 0;
+  std::vector<uint8_t> rgba = DecodeImageRGBA(datos, tamano, ancho, alto);
+  if (rgba.empty() || ancho <= 0 || alto <= 0) return nullptr;
+  auto icono = std::make_shared<IconoSuperposicion>();
+  icono->id = id;
+  const uint32_t kLado = std::clamp<uint32_t>(lado_maximo, 1, 256);  // the largest the caller draws
+  const uint32_t w = uint32_t(ancho), h = uint32_t(alto);
+  if (w <= kLado && h <= kLado) {
+    icono->ancho = w;
+    icono->alto = h;
+    icono->rgba = std::move(rgba);
+    return icono;
+  }
+  // A box filter (alpha-weighted) down to fit kLado x kLado, keeping the aspect.
+  const uint32_t dw = w >= h ? kLado : std::max<uint32_t>(1, kLado * w / h);
+  const uint32_t dh = h >= w ? kLado : std::max<uint32_t>(1, kLado * h / w);
+  icono->ancho = dw;
+  icono->alto = dh;
+  icono->rgba.resize(size_t(dw) * dh * 4);
+  for (uint32_t dy = 0; dy < dh; ++dy) {
+    const uint32_t sy0 = dy * h / dh, sy1 = std::max(sy0 + 1, (dy + 1) * h / dh);
+    for (uint32_t dx = 0; dx < dw; ++dx) {
+      const uint32_t sx0 = dx * w / dw, sx1 = std::max(sx0 + 1, (dx + 1) * w / dw);
+      uint64_t r = 0, g = 0, b = 0, a = 0, n = 0;
+      for (uint32_t sy = sy0; sy < sy1; ++sy) {
+        for (uint32_t sx = sx0; sx < sx1; ++sx) {
+          const uint8_t* p = rgba.data() + (size_t(sy) * w + sx) * 4;
+          r += uint64_t(p[0]) * p[3];
+          g += uint64_t(p[1]) * p[3];
+          b += uint64_t(p[2]) * p[3];
+          a += p[3];
+          ++n;
+        }
+      }
+      uint8_t* t = icono->rgba.data() + (size_t(dy) * dw + dx) * 4;
+      t[0] = a ? uint8_t(r / a) : 0;  // straight color: alpha-weighted average
+      t[1] = a ? uint8_t(g / a) : 0;
+      t[2] = a ? uint8_t(b / a) : 0;
+      t[3] = uint8_t(a / n);
+    }
+  }
+  return icono;
+}
+
+void FijarLetreiro(std::string texto) {
+  auto& s = rex::deko3d::LaSuperposicion();
+  std::lock_guard<std::mutex> cerrojo(s.candado);
+  if (texto == s.letreiro) return;
+  s.letreiro = std::move(texto);
+  ++s.version;
+}
+
+void AvisarSuperposicion(std::vector<std::string> lineas) { AvisarSuperposicionConIcono(std::move(lineas), {}); }
+}  // namespace rex::ui
