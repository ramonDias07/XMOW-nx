+// ---- The frame dump (PedirVolcado)
+
+bool RenderDk::VolcarResuelta(const ImagenDk& imagen, uint32_t base, uint32_t formato_guest, const char* etiqueta,
+                              uint32_t alto_volcado, bool prioritario) {
+  volcado_motivo_ = nullptr;
+  uint32_t bpp = 0;
+  switch (imagen.formato) {
+    case DkImageFormat_RGBA8_Unorm:
+    case DkImageFormat_RGB10A2_Unorm:
+    case DkImageFormat_R32_Float:
+    case DkImageFormat_RG16_Float:
+    case DkImageFormat_Z24S8:
+      bpp = 4;
+      break;
+    case DkImageFormat_RGBA16_Float:
+    case DkImageFormat_RGBA16_Unorm:
+    case DkImageFormat_RG32_Float:
+      bpp = 8;
+      break;
+    // xmow 1026: the formats a game texture (not a resolved one) can have.
+    case DkImageFormat_R8_Unorm:
+      bpp = 1;
+      break;
+    case DkImageFormat_RG8_Unorm:
+    case DkImageFormat_R16_Float:
+    case DkImageFormat_R16_Unorm:
+    case DkImageFormat_RGB565_Unorm:
+      bpp = 2;
+      break;
+    default:
+      bpp = BytesBloqueVolcado(imagen.formato);  // BC1-BC5: bytes of a 4x4 block
+      if (!bpp) {
+        volcado_motivo_ = "host image format not supported by the dump";
+        return false;
+      }
+      break;
+  }
+  const bool bc = BytesBloqueVolcado(imagen.formato) != 0;
+  uint32_t alto = alto_volcado ? std::min(alto_volcado, imagen.alto) : imagen.alto;
+  if (bc) {
+    alto = std::min((alto + 3) & ~3u, imagen.alto);
+  }
+  const uint32_t fila = bc ? ((imagen.ancho + 3) / 4) * bpp : imagen.ancho * bpp;
+  const uint32_t bytes = bc ? fila * ((alto + 3) / 4) : fila * alto;
+  const uint32_t capacidad = volcado_capacidad_ ? volcado_capacidad_ : kBytesVolcadoBase;
+  const uint32_t limite = prioritario ? capacidad : LimiteOrdinarioVolcado(capacidad);  // xmow 1031
+  if (volcado_.size() >= (prioritario ? kEntradasVolcado : kEntradasVolcadoBase)) {
+    volcado_motivo_ = "too many entries in the dump";
+    return false;
+  }
+  if (volcado_usados_ + bytes > limite) {
+    volcado_motivo_ = "no room in the dump block";
+    REXLOG_WARN("[deko3d] dump: no room for {:08X} ({}x{}, {} KiB): {} of {} KiB used, {} entries{}", base, imagen.ancho,
+                alto, bytes >> 10, volcado_usados_ >> 10, limite >> 10, volcado_.size(),
+                prioritario ? " (priority)" : "");
+    return false;
+  }
+  AntesDeTransferir();
+  const DkImageView vista = VistaCompleta(imagen.imagen);
+  const DkImageRect rect = {0, 0, 0, imagen.ancho, alto, 1};
+  const DkCopyBuf destino = {volcado_gpu_ + volcado_usados_, fila, bytes};
+  CausaCopiaDk causa(*this, kCcVolcado, base, formato_guest);
+  const int32_t op = EmpezarCopiaMotor(imagen.ancho, alto);
+  XmowCopyImageToBuffer(nucleo_.comandos(), &vista, &rect, &destino, 0);
+  PerfilOpTerminar(op);
+  // xmow 1031: PS inputs (prioritario) and float targets also go out as raw bytes (.bin); the image's (serie, version)
+  // is remembered, so a PS input that is still the image of an entry already dumped is not copied again.
+  const bool flotante = imagen.formato == DkImageFormat_RGBA16_Float || imagen.formato == DkImageFormat_RG16_Float ||
+                        imagen.formato == DkImageFormat_R32_Float || imagen.formato == DkImageFormat_RG32_Float ||
+                        imagen.formato == DkImageFormat_R16_Float;
+  volcado_imagenes_[imagen.serie ^ (imagen.version * 0x9E3779B97F4A7C15ull)] = uint32_t(volcado_.size());
+  volcado_.push_back(
+      {volcado_usados_, imagen.ancho, alto, bpp, base, formato_guest, imagen.formato, etiqueta, prioritario || flotante});
+  volcado_usados_ += (bytes + 255) & ~255u;
+  return true;
+}
+
+// xmow 1015: the dumped frame's first alpha-blended translucent into the scene (Dibujar): the depth target it is about to
+// bind, as EmpezarPase would leave it (its pending clear done, its content restored), copied on the 3D engine into an
+// uncompressed image (only the rows in use) and dumped as "..._profundidad_en_el_primer_translucido".
+void RenderDk::VolcarProfundidadDeTranslucido(ImagenDk& z, uint32_t base_edram, uint32_t control_z, uint32_t ps) {
+  const uint64_t ahora = deko::AhoraNs();
+  auto ms = [&](uint64_t ns) { return ns >= ns_inicio_fotograma_ ? double(ns - ns_inicio_fotograma_) / 1e6 : -1.0; };
+  auto dibujo = [&](uint64_t d, uint64_t f) {
+    return f == fotograma_ ? fmt::format("dibujo {} de este fotograma", d - dibujos_inicio_fotograma_)
+           : f == 0        ? std::string("nunca")
+                           : fmt::format("fotograma {} ({} atras)", f, fotograma_ - f);
+  };
+  const bool borrada_despues = z.borrada_fotograma &&
+                               (z.borrada_dibujo > z.escrita_dibujo ||
+                                (z.borrada_dibujo == z.escrita_dibujo && z.borrada_ns > z.escrita_ns));
+  const uint32_t cc = z.borrado_copy_control;
+  REXLOG_INFO("[deko3d] volcado: profundidad en el primer translucido (dibujo {} del fotograma, PS n{}, RB_DEPTHCONTROL "
+              "{:08X}, {:.2f} ms tras el Swap): Z base {:03X} formato {} {}x{} (serie {}, version {}, alto usado {}); "
+              "borrado pendiente {} (Z {:.6f}, estencil {}, solo estencil {}), contenido_invalido {}, resuelta_base "
+              "{:08X}; ultima escritura de Z: {} ({:.2f} ms), ultimo borrado de Z hecho: {} ({:.2f} ms) -> {}; ultimo "
+              "borrado pedido por el juego: {} con RB_COPY_CONTROL {:08X} (origen {}, copia {}, borra color {}, borra Z "
+              "{}, solo estencil {}) y RB_DEPTH_CLEAR {:08X}",
+              dibujados_ - dibujos_inicio_fotograma_, ps, control_z, ms(ahora), base_edram, z.formato_juego, z.ancho,
+              z.alto, z.serie, z.version, z.alto_usado, z.borrado_pendiente ? "SI" : "no", z.borrado_z,
+              z.borrado_estencil, z.borrado_solo_estencil ? "si" : "no", z.contenido_invalido ? "SI" : "no",
+              z.resuelta_base, dibujo(z.escrita_dibujo, z.escrita_fotograma), ms(z.escrita_ns),
+              dibujo(z.borrada_dibujo, z.borrada_fotograma), ms(z.borrada_ns),
+              borrada_despues ? "BORRADA DESPUES de su ultima escritura" : "escrita despues de su ultimo borrado",
+              dibujo(z.borrado_pedido_dibujo, z.borrado_pedido_fotograma), cc, cc & 0x7,
+              (cc >> 20) & 0x3, (cc >> 8) & 0x1, (cc >> 9) & 0x1, (cc >> 30) & 0x1, z.borrado_bits);
+  // What EmpezarPase does right after binding it.
+  HacerBorradoPendiente(z);
+  RestaurarContenido(z, false);
+  const uint32_t alto = std::min(z.alto, z.alto_usado ? (z.alto_usado + 7) & ~7u : 720u);
+  if (!z_volcado_.viva || z_volcado_.ancho != z.ancho || z_volcado_.alto != alto) {
+    DestruirImagen(z_volcado_);
+    if (!CrearImagen(z_volcado_, DkImageType_2D, DkImageFormat_Z24S8, z.ancho, alto, 1, 1, DkImageFlags_UsageRender,
+                     "copia de Z para el volcado")) {
+      return;
+    }
+  }
+  bool hecho = false;
+  {
+    CausaCopiaDk causa(*this, kCcVolcado, base_edram, z.formato_juego);
+    if (Copiar3D(z, 0, 0, z.ancho, alto, z_volcado_, 0, 0)) {
+      hecho = VolcarResuelta(z_volcado_, 0xFED00000u | base_edram, z.formato_juego,
+                             "profundidad_en_el_primer_translucido");
+    } else {
+      hecho = VolcarResuelta(z, 0xFED00000u | base_edram, z.formato_juego,
+                             "profundidad_en_el_primer_translucido_directa", alto);
+    }
+  }
+  if (!hecho) {
+    REXLOG_WARN("[deko3d] volcado: la profundidad del primer translucido no cupo en el volcado ({} entradas, {} MB)",
+                volcado_.size(), volcado_usados_ >> 20);
+  }
+  OlvidarEstado();
+  g_.pase_valido = false;  // the draw binds its targets again
+}
+
+void RenderDk::TerminarVolcado() {
+  const uint64_t inicio_ns = deko::AhoraNs();  // xmow 1031: ring time per frame ([xmow hitch])
+  volcando_ = false;
+  CerrarTrabajo();
+  proveedor_.dispositivo().EsperarInactiva();
+  dkMemBlockFlushCpuCache(volcado_bloque_, 0, std::max<uint32_t>(volcado_usados_, 256));  // what the GPU wrote
+  // xmow 1031: no copy of the bytes to the heap and no folder lookup here (both on the ring: ~65 MB of memcpy and SD
+  // directory calls while the card is busy). The writer thread reads the block itself; Presentar starts no new dump
+  // while a write is pending (EscriturasSdPendientes), so the block is not reused under it. The writer picks the next
+  // free volcado_NN folder.
+  REXLOG_INFO("[xmow dump] frame dumped: {} images ({} MiB of the {} MiB block) handed to the SD writer thread; {} "
+              "resolves in the frame, {} pixel shaders with their inputs dumped, {} depth resolves skipped "
+              "(xmow_dk_volcado_sombras false), {} per-draw state lines",
+              volcado_.size(), volcado_usados_ >> 20, volcado_capacidad_ >> 20, volcado_resolves_,
+              volcado_ps_hechos_.size(), volcado_omitidas_z_, volcado_lineas_dibujo_);
+  EncolarEscrituraSd([entradas = std::move(volcado_), bloque = static_cast<const uint8_t*>(volcado_cpu_)]() {
+  static uint32_t siguiente = 0;  // XMOW: the next free number (each start used to count from 00 again)
+  char nombre[160];
+  std::error_code ec;
+  std::filesystem::path carpeta;
+  do {
+    std::snprintf(nombre, sizeof(nombre), "volcado_%02u", siguiente++);
+    carpeta = rex::filesystem::GetExecutableFolder() / nombre;
+  } while (std::filesystem::exists(carpeta, ec) && siguiente < 100);
+  std::filesystem::create_directories(carpeta, ec);
+  REXLOG_INFO("[xmow dump] writing {} images to {}", entradas.size(), carpeta.string());
+  // xmow 1031: indice.txt: one line per entry (number, base, size, guest format, host DkImageFormat, bytes per texel or
+  // BC block, label, raw .bin written), for scripts reading the .bin files.
+  std::string indice = "n base width height guest_fmt host_fmt bpp label raw\n";
+  for (size_t n = 0; n < entradas.size(); ++n) {
+    const EntradaVolcado& e = entradas[n];
+    indice += fmt::format("{:02} {:08X} {} {} {} {} {} {} {}\n", n, e.base, e.ancho, e.alto, e.formato_guest,
+                          uint32_t(e.formato), e.bpp, e.etiqueta ? e.etiqueta : "-", e.crudo ? 1 : 0);
+  }
+  EscribirArchivoEnTrozos(carpeta / "indice.txt", indice.data(), indice.size());
+  for (size_t n = 0; n < entradas.size(); ++n) {
+    const EntradaVolcado& e = entradas[n];
+    const uint8_t* datos = bloque + e.offset;
+    const size_t texels = size_t(e.ancho) * e.alto;
+    std::vector<float> c(texels * 4, 0.0f);
+    bool alfa = false;
+    const bool bloques = BytesBloqueVolcado(e.formato) != 0;
+    if (bloques) {
+      alfa = DecodificarBcVolcado(e.formato, datos, e.ancho, e.alto, c);  // xmow 1026
+    }
+    for (size_t i = 0; i < (bloques ? 0 : texels); ++i) {
+      float* t = &c[i * 4];
+      uint32_t v = 0;
+      std::memcpy(&v, datos + i * e.bpp, std::min<uint32_t>(e.bpp, 4));
+      switch (e.formato) {
+        // xmow 1026: the formats of the game textures.
+        case DkImageFormat_R8_Unorm:
+          t[0] = t[1] = t[2] = float(v & 0xFF) / 255.0f;
+          break;
+        case DkImageFormat_RG8_Unorm:
+          t[0] = float(v & 0xFF) / 255.0f;
+          t[1] = float((v >> 8) & 0xFF) / 255.0f;
+          break;
+        case DkImageFormat_R16_Unorm:
+          t[0] = t[1] = t[2] = float(v & 0xFFFF) / 65535.0f;
+          break;
+        case DkImageFormat_R16_Float:
+          t[0] = t[1] = t[2] = MedioAFloat(uint16_t(v));
+          break;
+        case DkImageFormat_RGB565_Unorm:
+          t[0] = float(v & 31) / 31.0f;
+          t[1] = float((v >> 5) & 63) / 63.0f;
+          t[2] = float((v >> 11) & 31) / 31.0f;
+          break;
+        case DkImageFormat_RGBA16_Unorm: {
+          uint16_t h[4];
+          std::memcpy(h, datos + i * 8, 8);
+          for (int k = 0; k < 4; ++k) t[k] = float(h[k]) / 65535.0f;
+          alfa = true;
+          break;
+        }
+        case DkImageFormat_RGBA8_Unorm:
+          for (int k = 0; k < 4; ++k) t[k] = float((v >> (8 * k)) & 0xFF) / 255.0f;
+          alfa = true;
+          break;
+        case DkImageFormat_RGB10A2_Unorm:
+          for (int k = 0; k < 3; ++k) t[k] = float((v >> (10 * k)) & 0x3FF) / 1023.0f;
+          t[3] = float(v >> 30) / 3.0f;
+          alfa = true;
+          break;
+        case DkImageFormat_R32_Float:
+          std::memcpy(&t[0], &v, 4);
+          t[1] = t[2] = t[0];
+          break;
+        case DkImageFormat_RG16_Float:
+          t[0] = MedioAFloat(uint16_t(v));
+          t[1] = MedioAFloat(uint16_t(v >> 16));
+          break;
+        case DkImageFormat_RGBA16_Float: {
+          uint16_t h[4];
+          std::memcpy(h, datos + i * 8, 8);
+          for (int k = 0; k < 4; ++k) t[k] = MedioAFloat(h[k]);
+          alfa = true;
+          break;
+        }
+        case DkImageFormat_RG32_Float:
+          std::memcpy(&t[0], datos + i * 8, 4);
+          std::memcpy(&t[1], datos + i * 8 + 4, 4);
+          break;
+        case DkImageFormat_Z24S8:
+          // deko3d's Z24S8 keeps the depth in the upper 24 bits and the stencil in the lower 8 (read as the lower 24
+          // bits, a smooth floor came out as a sawtooth).
+          t[0] = float(v >> 8);  // normalized below by the image's range
+          t[3] = float(v & 0xFF) / 255.0f;
+          break;
+        default:
+          break;
+      }
+    }
+    // Floats and depth are scaled by the image's range, written in the name.
+    const bool profundidad = e.formato == DkImageFormat_Z24S8;
+    const bool flotante = e.formato == DkImageFormat_R32_Float || e.formato == DkImageFormat_RG16_Float ||
+                          e.formato == DkImageFormat_RGBA16_Float || e.formato == DkImageFormat_RG32_Float ||
+                          e.formato == DkImageFormat_R16_Float;
+    // xmow 1026: a float/HDR image (16_16_16_16_FLOAT, 16_16_EXPAND, ...) is written twice: the main BMP scaled by its
+    // range (minimo..maximo, in the name), and "_clamp01": each channel clamped to 0..1 as a display would show it.
+    // NaN and infinity count as 0 in both.
+    if (flotante) {
+      for (float& x : c) {
+        if (!std::isfinite(x)) x = 0.0f;
+      }
+    }
+    float minimo = 0.0f, maximo = 1.0f;
+    if (profundidad || flotante) {
+      minimo = profundidad ? c[0] : 0.0f;
+      maximo = profundidad ? c[0] : 1.0f;
+      for (size_t i = 0; i < texels; ++i) {
+        for (int k = 0; k < (profundidad ? 1 : 3); ++k) {
+          const float x = c[i * 4 + k];
+          if (std::isfinite(x)) {
+            minimo = std::min(minimo, x);
+            maximo = std::max(maximo, x);
+          }
+        }
+      }
+      if (profundidad) {
+        for (size_t i = 0; i < texels; ++i) c[i * 4 + 1] = c[i * 4 + 2] = c[i * 4];
+      }
+    }
+    const float escala = maximo > minimo ? 1.0f / (maximo - minimo) : 1.0f;
+    std::vector<uint8_t> bgr(texels * 3), a(texels * 3);
+    for (size_t i = 0; i < texels; ++i) {
+      for (int k = 0; k < 3; ++k) {
+        const float x = std::clamp((c[i * 4 + k] - minimo) * escala, 0.0f, 1.0f);
+        bgr[i * 3 + (2 - k)] = uint8_t(x * 255.0f + 0.5f);
+      }
+      const uint8_t al = uint8_t(std::clamp(c[i * 4 + 3], 0.0f, 1.0f) * 255.0f + 0.5f);
+      a[i * 3] = a[i * 3 + 1] = a[i * 3 + 2] = al;
+    }
+    std::snprintf(nombre, sizeof(nombre), "%02u_%08X_%ux%u_g%u%s_rango_%g_%g%s%s", unsigned(n), e.base, e.ancho,
+                  e.alto, e.formato_guest, profundidad ? "_z" : "", double(minimo), double(maximo),
+                  e.etiqueta ? "_" : "", e.etiqueta ? e.etiqueta : "");
+    EscribirBmp(carpeta / (std::string(nombre) + ".bmp"), e.ancho, e.alto, bgr);
+    if (alfa) {
+      EscribirBmp(carpeta / (std::string(nombre) + "_alfa.bmp"), e.ancho, e.alto, a);
+    }
+    if (flotante) {
+      std::vector<uint8_t> limitada(texels * 3);
+      for (size_t i = 0; i < texels; ++i) {
+        for (int k = 0; k < 3; ++k) {
+          limitada[i * 3 + (2 - k)] = uint8_t(std::clamp(c[i * 4 + k], 0.0f, 1.0f) * 255.0f + 0.5f);
+        }
+      }
+      EscribirBmp(carpeta / (std::string(nombre) + "_clamp01.bmp"), e.ancho, e.alto, limitada);
+    }
+    // xmow 1031: the bytes as the GPU wrote them (float16/float32 targets keep values under 1/255, e.g. s0 ~0.003).
+    if (e.crudo) {
+      EscribirArchivoEnTrozos(carpeta / (std::string(nombre) + ".bin"), datos,
+                              BytesImagenVolcado(e.formato, e.ancho, e.alto, e.bpp));
+    }
+  }
+  REXLOG_INFO("[deko3d] volcado: {} texturas escritas en {}", entradas.size(), carpeta.string());
+  REXLOG_INFO("[deko3d] dump: float/HDR images are written as the main BMP scaled by the range in the name (min..max of "
+              "RGB) plus a *_clamp01.bmp with each channel clamped to 0..1; BC1-BC5 game textures are decoded on the "
+              "CPU; NaN/Inf count as 0; *.bin are the raw bytes (see indice.txt)");
