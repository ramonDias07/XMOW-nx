+    case '%': return kPorcentaje;
+    case '\'': return kApostrofo;
+    case '=': return kIgual;
+    case '>': return kMayor;
+    case ':': return kDosPuntos;
+    case '/': return kBarra;
+    case '(': return kAbre;
+    case ')': return kCierra;
+    case '-': return kGuion;
+    case '+': return kMas;
+    case '!': return kExclamacion;
+    case ',': return kComa;
+    case 'x': return kPor;
