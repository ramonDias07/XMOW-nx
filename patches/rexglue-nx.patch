+// xmow 1025: the count and whether its depth was valid for every draw of the query that tested it (Dibujar).
+bool RenderDk::ResultadoOclusionZ(uint64_t ticket, uint64_t& muestras, bool& z_valida) {
+  LeerOclusionesTerminadas();
+  const auto it = oclusion_listas_.find(ticket);
+  z_valida = it != oclusion_listas_.end() && !(it->second & kOclusionZInvalida);
+  return ResultadoOclusion(ticket, muestras);
+}
