+  }
+  for (size_t i = 0; i < perfil_ops_.size(); ++i) {
+    const size_t at = (size_t(kMarcasPerfil) + i) * 32;
+    uint64_t t0 = 0, t1 = 0;
+    std::memcpy(&t0, perfil_cpu_ + at + 8, sizeof(t0));
+    std::memcpy(&t1, perfil_cpu_ + at + 24, sizeof(t1));
+    if (!t0 || !t1 || t1 < t0) {
+      ++sin_medir;
+      continue;
+    }
+    lapso(t0, t1);
+    const double ns = double(t1 - t0) * deko::kNsPorUnidadGpu;
