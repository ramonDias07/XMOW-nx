+// xmow 1030: the copy keeps the source's channels (texelFetch, no swizzle) in a float format, so a scaled value above 1
+// survives; a depth source goes to R32_Float (its depth in R, as the depth view returns it).
+const ImagenDk* RenderDk::ResueltaEscalada(const ImagenDk& origen, int32_t exp_adjust) {
+  if (exp_adjust == 0) {
+    return &origen;
+  }
+  DkImageFormat formato;
+  switch (origen.formato) {
+    case DkImageFormat_R16_Float:
+    case DkImageFormat_RG16_Float:
+    case DkImageFormat_RGBA16_Float:
+    case DkImageFormat_R32_Float:
+    case DkImageFormat_RG32_Float:
+    case DkImageFormat_RGBA32_Float:
+      formato = origen.formato;
+      break;
+    case DkImageFormat_Z24S8:
+    case DkImageFormat_ZF32_X24S8:
+      formato = DkImageFormat_R32_Float;
+      break;
+    default:
+      formato = DkImageFormat_RGBA16_Float;
+      break;
+  }
+  if (escaladas_.size() > 64) {  // resolves recreated at other sizes leave theirs behind
+    for (auto& [clave, c] : escaladas_) {
+      DestruirImagen(c.imagen);
+    }
+    escaladas_.clear();
+  }
+  ConvertidaSigno& c = escaladas_[(origen.serie << 8) | uint64_t(uint32_t(exp_adjust) & 0x3F)];
+  if (!c.imagen.viva) {
+    if (!CrearImagen(c.imagen, DkImageType_2D, formato, origen.ancho, origen.alto, 1, 1, DkImageFlags_UsageRender,
+                     "texture scaled by exp_adjust")) {
+      escaladas_.erase((origen.serie << 8) | uint64_t(uint32_t(exp_adjust) & 0x3F));
+      return nullptr;
+    }
+    REXLOG_INFO("[xmow exp_adjust] resolved texture {:08X} {}x{} (host format {}) sampled with exp_adjust {}: "
+                "scaled copy x{} (host format {})",
+                origen.base_juego, origen.ancho, origen.alto, uint32_t(origen.formato), exp_adjust,
+                std::ldexp(1.0f, exp_adjust), uint32_t(formato));
+  }
+  c.imagen.intercambio_rb = origen.intercambio_rb;
+  if (c.version != origen.version) {
+    CausaCopiaDk causa(*this, kCcSigno, origen.base_juego, origen.formato_juego);
+    if (!Copiar3D(origen, 0, 0, origen.ancho, origen.alto, c.imagen, 0, 0, nullptr, false,
+                  std::ldexp(1.0f, exp_adjust))) {
+      return nullptr;
+    }
+    OlvidarEstado();  // the copy bound its own target and shaders; the draw binds its pass again
+    c.version = origen.version;
+    ++c.imagen.version;
+  }
+  return &c.imagen;
+}
