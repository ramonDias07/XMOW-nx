+ * and the disk lock is never held during a pread (the other mistake of the NFSMW cache).
+ *
+ * 0 turns it off. Default 64 MB (see the report of the patch for how it was chosen).
+ */
+REXCVAR_DEFINE_INT32(xmow_io_cache_mb, 64, "Filesystem",
+                     "Cache LRU de bloques de 128 KiB para lecturas de solo lectura de ficheros grandes "
+                     "(.tfc, paquetes .xxx), tope en MB (0 = apagada). Memoria del heap del anfitrion.");
+
+REXCVAR_DEFINE_BOOL(xmow_io_leitura_antecipada, false, "Filesystem",
+                    "Lee por adelantado el bloque siguiente (hilo de baja prioridad) cuando el juego lee "
+                    "un fichero en secuencia. Necesita xmow_io_cache_mb > 0.");
+
+REXCVAR_DEFINE_INT32(xmow_io_cache_min_kb, 96, "Filesystem",
+                     "Solo pasan por la cache de bloques las lecturas de estos KB o mas (por debajo, "
+                     "un bloque de 128 KiB seria amplificacion pura).");
+
+REXCVAR_DEFINE_INT32(xmow_io_cache_fichero_min_mb, 4, "Filesystem",
+                     "Solo ficheros de este tamano en MB o mas usan la cache de bloques (los pequenos ya "
+                     "los cubre la ventana).");
+
+REXCVAR_DEFINE_INT32(xmow_io_cache_resumen_s, 10, "Filesystem",
+                     "Cada cuantos segundos se escribe el resumen [io-cache] (0 = nunca).");
