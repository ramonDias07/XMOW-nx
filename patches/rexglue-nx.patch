+  static std::unordered_set<std::string> vistos;
+  {
+    std::lock_guard<std::mutex> lock(cerrojo);
+    if (vistos.size() >= 8192 || !vistos.insert(nombre).second) return;
+  }
+  REXKRNL_INFO("[XMOW mapa] {}", nombre);
+}
