+inline void AnotarPaqueteUe3(const std::string_view ruta) {
+  if (ruta.size() < 5) return;
+  const auto ext = ruta.substr(ruta.size() - 4);
+  if (ext[0] != '.' || (ext[1] | 0x20) != 'x' || (ext[2] | 0x20) != 'x' || (ext[3] | 0x20) != 'x') return;
