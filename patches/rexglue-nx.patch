 }  // namespace
 
+/*
+ * ================================================================================================
+ * Patch 1020: block cache (xmow_io_cache_mb) and read-ahead (xmow_io_leitura_antecipada).
+ *
+ * Everything lives in one heap-allocated state that is never freed: the read-ahead thread may still
+ * be running when the process ends, and static destructors under it would be undefined behaviour.
+ *
+ *  - 128 KiB blocks, key = (file id << 32 | block). LRU = std::list (front = most recent) + hash index.
+ *  - Memory: one buffer per block, allocated on demand with new(nothrow) up to the cap; when the cap is
+ *    reached the buffer of the evicted block is reused, so in steady state it does not allocate. If
+ *    allocation fails the cache turns itself off for good (never takes the process down).
+ *  - One mutex, held only for table lookups and memcpy of <= 256 KiB. Never across a pread.
+ *  - Per-file-id generation: opening a path for writing (or writing/truncating) bumps it and drops the
+ *    blocks of that id, so a read that was in flight cannot insert stale data afterwards.
+ * ================================================================================================
+ */
+namespace {
+
+constexpr size_t kBloqueXio = 128 * 1024;
+constexpr size_t kColaAnticMax = 8;
+
+struct BloqueXio {
+  uint64_t clave = 0;
+  std::unique_ptr<uint8_t[]> datos;
+  uint32_t len = 0;       // can be < kBloqueXio only at the end of the file
+  uint32_t us_disco = 0;  // how long the SD read that brought it took (shared among the blocks of that read)
+  bool antic = false;     // brought by read-ahead and not used yet
+};
+
+struct TrabajoAntic {
+  std::shared_ptr<FileHandle> fh;
+  uint32_t id = 0;
+  uint32_t gen = 0;
+  uint64_t bloque = 0;
+  uint64_t tam = 0;
+};
+
+struct EstadoXio {
+  std::mutex mutex;
+  std::list<BloqueXio> lista;
+  std::unordered_map<uint64_t, std::list<BloqueXio>::iterator> indice;
+  std::unordered_map<std::string, uint32_t> ids;
+  std::vector<uint32_t> generacion{0};  // [id]; index 0 unused
+  uint64_t alocados = 0;                // buffers alive, in blocks
+  bool sin_memoria = false;
+
+  std::mutex mutex_cola;
+  std::condition_variable cv_cola;
+  std::deque<TrabajoAntic> cola;
+  bool hilo_creado = false;
+
+  std::atomic<uint64_t> aciertos{0}, fallos{0}, bloques_ram{0}, bytes_ram{0}, bytes_sd{0};
+  std::atomic<uint64_t> lentas_evitadas{0}, expulsiones{0}, no_elegibles{0};
+  std::atomic<uint64_t> antic_pedidas{0}, antic_hechas{0}, antic_usadas{0};
+  std::atomic<int64_t> proximo_resumen_ms{0};
+  // Snapshot for the per-interval deltas of the log line (touched only by whoever wins the CAS above).
+  EstadisticasBloques foto;
+};
+
+EstadoXio& Xio() {
+  static EstadoXio* e = new EstadoXio();  // intentionally never freed
+  return *e;
+}
+
+inline uint64_t ClaveXio(uint32_t id, uint64_t bloque) {
+  return (static_cast<uint64_t>(id) << 32) | (bloque & 0xFFFFFFFFull);
+}
+
+inline uint64_t AhoraUsXio() {
+  return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+                                   std::chrono::steady_clock::now().time_since_epoch())
+                                   .count());
+}
+
+uint64_t TopeBloquesXio() {
+  const int64_t mb = REXCVAR_GET(xmow_io_cache_mb);
+  return mb > 0 ? (static_cast<uint64_t>(mb) * 1024u * 1024u) / kBloqueXio : 0;
+}
+
+// Drops every block of the id. Called with the mutex held.
+void SoltarBloquesDeIdLocked(EstadoXio& E, uint32_t id) {
+  for (auto it = E.lista.begin(); it != E.lista.end();) {
+    if ((it->clave >> 32) == id) {
+      E.indice.erase(it->clave);
+      it = E.lista.erase(it);
+      if (E.alocados) --E.alocados;
+    } else {
+      ++it;
+    }
+  }
+}
+
+uint32_t XioIdDeRuta(const std::string& ruta, uint32_t* gen) {
+  EstadoXio& E = Xio();
+  std::lock_guard lock(E.mutex);
+  auto [it, nuevo] = E.ids.try_emplace(ruta, 0);
+  if (nuevo) {
+    it->second = static_cast<uint32_t>(E.generacion.size());
+    E.generacion.push_back(0);
+  }
+  *gen = E.generacion[it->second];
+  return it->second;
+}
+
+// A path is being opened for writing, written or truncated: nothing cached from it may survive.
+void XioInvalidarRuta(const std::string& ruta) {
+  EstadoXio& E = Xio();
+  std::lock_guard lock(E.mutex);
+  const auto it = E.ids.find(ruta);
+  if (it == E.ids.end()) return;
+  ++E.generacion[it->second];
+  SoltarBloquesDeIdLocked(E, it->second);
+}
+
+// Stores a block. Takes the mutex itself. `src` has `len` valid bytes.
+void XioGuardar(uint32_t id, uint32_t gen, uint64_t bloque, const uint8_t* src, uint32_t len,
+                uint32_t us_disco, bool antic) {
+  EstadoXio& E = Xio();
+  const uint64_t tope = TopeBloquesXio();
+  std::lock_guard lock(E.mutex);
+  if (E.sin_memoria || !tope || E.generacion[id] != gen) return;
+  const uint64_t clave = ClaveXio(id, bloque);
+  if (E.indice.count(clave)) return;  // another thread got there first
+
+  // The cap can also have been lowered at runtime: trim down to it.
+  while (E.alocados > tope && E.lista.size() > 1) {
+    E.indice.erase(E.lista.back().clave);
+    E.lista.pop_back();
+    --E.alocados;
+    E.expulsiones.fetch_add(1, std::memory_order_relaxed);
+  }
+
+  std::unique_ptr<uint8_t[]> buf;
+  if (E.alocados >= tope && !E.lista.empty()) {
+    // At the cap: reuse the buffer of the least recently used block.
+    auto& viejo = E.lista.back();
+    buf = std::move(viejo.datos);
+    E.indice.erase(viejo.clave);
+    E.lista.pop_back();
+    E.expulsiones.fetch_add(1, std::memory_order_relaxed);
+  } else {
+    buf.reset(new (std::nothrow) uint8_t[kBloqueXio]);
+    if (!buf) {
+      const uint64_t tenia = (E.alocados * kBloqueXio) >> 20;
+      E.sin_memoria = true;
+      E.lista.clear();
+      E.indice.clear();
+      E.alocados = 0;
+      REXLOG_WARN("[io-cache] out of memory, cache turned off for good (was at {} MB). The game keeps "
+                  "reading from the SD as before",
+                  tenia);
+      return;
+    }
+    ++E.alocados;
+  }
+  std::memcpy(buf.get(), src, len);
+  BloqueXio b;
+  b.clave = clave;
+  b.datos = std::move(buf);
+  b.len = len;
+  b.us_disco = us_disco;
+  b.antic = antic;
+  E.lista.push_front(std::move(b));
+  E.indice[clave] = E.lista.begin();
+}
+
+// Reads `bytes` from `offset` in pieces until done or EOF (n == 0). A short read is not EOF.
+// Returns false only if the first call fails with nothing read. *eof says whether 0 bytes ended it.
+bool LeerTramoXio(FileHandle* fh, uint64_t offset, uint8_t* dst, size_t bytes, size_t* leidos,
+                  bool* eof) {
+  *leidos = 0;
+  *eof = false;
+  while (*leidos < bytes) {
+    size_t n = 0;
+    if (!fh->Read(offset + *leidos, dst + *leidos, bytes - *leidos, &n)) {
+      return *leidos != 0;
+    }
+    if (n == 0) {
+      *eof = true;
+      break;
+    }
+    *leidos += n;
+  }
+  return true;
+}
+
+void ResumenXio(bool forzar);
+
+void* HiloAnticipado(void*) {
+#if REX_PLATFORM_SWITCH
+  // Lowest band: it must never compete with the game's threads.
+  RexSwitchSetCurrentThreadPriority(0x3E);
+#endif
+  EstadoXio& E = Xio();
+  std::vector<uint8_t> tmp(kBloqueXio);
+  for (;;) {
+    TrabajoAntic t;
+    {
+      std::unique_lock lock(E.mutex_cola);
+      E.cv_cola.wait(lock, [&] { return !E.cola.empty(); });
+      t = std::move(E.cola.front());
+      E.cola.pop_front();
+    }
+    if (!REXCVAR_GET(xmow_io_leitura_antecipada)) continue;
+    {
+      std::lock_guard lock(E.mutex);
+      if (E.sin_memoria || E.generacion[t.id] != t.gen || E.indice.count(ClaveXio(t.id, t.bloque))) {
+        continue;
+      }
+    }
+    if (t.bloque * kBloqueXio >= t.tam) continue;
+    size_t leidos = 0;
+    bool eof = false;
+    const uint64_t t0 = AhoraUsXio();
+    if (!LeerTramoXio(t.fh.get(), t.bloque * kBloqueXio, tmp.data(), kBloqueXio, &leidos, &eof) ||
+        leidos == 0) {
+      continue;
+    }
+    const uint64_t us = AhoraUsXio() - t0;
+    // A short block is only kept if it is the end of the file confirmed by a 0-byte read.
+    if (leidos == kBloqueXio || eof) {
+      E.bytes_sd.fetch_add(leidos, std::memory_order_relaxed);
+      E.antic_hechas.fetch_add(1, std::memory_order_relaxed);
+      XioGuardar(t.id, t.gen, t.bloque, tmp.data(), static_cast<uint32_t>(leidos),
+                 static_cast<uint32_t>(std::min<uint64_t>(us, 0xFFFFFFFFull)), true);
+    }
+  }
+  return nullptr;
+}
+
+void PedirAnticipada(const std::shared_ptr<FileHandle>& fh, uint32_t id, uint32_t gen,
+                     uint64_t bloque, uint64_t tam) {
+  EstadoXio& E = Xio();
+  if (bloque * kBloqueXio >= tam) return;
+  {
+    std::lock_guard lock(E.mutex);
+    if (E.sin_memoria || E.indice.count(ClaveXio(id, bloque))) return;
+  }
+  {
+    std::lock_guard lock(E.mutex_cola);
+    if (E.cola.size() >= kColaAnticMax) return;
+    for (const auto& t : E.cola) {
+      if (t.id == id && t.bloque == bloque) return;
+    }
+    if (!E.hilo_creado) {
+      E.hilo_creado = true;  // one try only
+      pthread_attr_t attr;
+      pthread_attr_init(&attr);
+      pthread_attr_setstacksize(&attr, 512 * 1024);
+      pthread_t th;
+      if (pthread_create(&th, &attr, HiloAnticipado, nullptr) == 0) {
+        pthread_detach(th);
+      } else {
+        REXLOG_WARN("[io-cache] could not create the read-ahead thread: read-ahead stays off");
+        pthread_attr_destroy(&attr);
+        return;
+      }
+      pthread_attr_destroy(&attr);
+    }
+    TrabajoAntic t;
+    t.fh = fh;
+    t.id = id;
+    t.gen = gen;
+    t.bloque = bloque;
+    t.tam = tam;
+    E.cola.push_back(std::move(t));
+  }
+  E.antic_pedidas.fetch_add(1, std::memory_order_relaxed);
+  E.cv_cola.notify_one();
+}
+
+/*
+ * Serves a read through the block cache. Returns false when it does not apply (not eligible, error
+ * on the first read, out of memory); then the usual path answers and nothing was touched.
+ */
+bool LeerConBloquesXio(const std::shared_ptr<FileHandle>& fh, uint32_t id, uint32_t gen,
+                       std::span<uint8_t> buffer, size_t byte_offset, size_t* out_bytes_read) {
+  EstadoXio& E = Xio();
+  const size_t pedido = buffer.size();
+  if (!pedido || E.sin_memoria) return false;
+  const uint64_t tope = TopeBloquesXio();
+  const uint64_t primero = byte_offset / kBloqueXio;
+  const uint64_t ultimo = (byte_offset + pedido - 1) / kBloqueXio;
+  const size_t nb = static_cast<size_t>(ultimo - primero + 1);
+  // At most 2 blocks and amplification <= ~1.33 (aligned reads are 1.0). The cache must fit a few blocks.
+  if (!tope || tope < 8 || nb > 2 || nb * kBloqueXio * 3 > pedido * 4 ||
+      pedido < static_cast<size_t>(std::max<int32_t>(REXCVAR_GET(xmow_io_cache_min_kb), 1)) * 1024u) {
+    E.no_elegibles.fetch_add(1, std::memory_order_relaxed);
+    return false;
+  }
+  const int32_t aviso_ms = REXCVAR_GET(nfsmw_io_aviso_ms);
+  const uint64_t umbral_us = aviso_ms > 0 ? static_cast<uint64_t>(aviso_ms) * 1000ull : UINT64_MAX;
+
+  // How much of the request each block covers, and where.
+  size_t quiere[2] = {0, 0}, obtuvo[2] = {0, 0};
+  bool listo[2] = {false, false};
+  auto porcion = [&](uint64_t b, size_t* desde_bloque, size_t* hacia_buf) {
+    const uint64_t ini = std::max<uint64_t>(byte_offset, b * kBloqueXio);
+    const uint64_t fin = std::min<uint64_t>(byte_offset + pedido, (b + 1) * kBloqueXio);
+    *desde_bloque = static_cast<size_t>(ini - b * kBloqueXio);
+    *hacia_buf = static_cast<size_t>(ini - byte_offset);
+    return static_cast<size_t>(fin - ini);
+  };
+  for (size_t i = 0; i < nb; ++i) {
+    size_t a, b2;
+    quiere[i] = porcion(primero + i, &a, &b2);
+  }
+
+  size_t aciertos_bloque = 0;
+  {
+    std::lock_guard lock(E.mutex);
+    if (E.generacion[id] != gen) return false;
+    for (size_t i = 0; i < nb; ++i) {
+      const auto it = E.indice.find(ClaveXio(id, primero + i));
+      if (it == E.indice.end()) continue;
+      BloqueXio& b = *it->second;
+      size_t desde, hacia;
+      porcion(primero + i, &desde, &hacia);
+      const size_t disponible = desde < b.len ? b.len - desde : 0;
+      const size_t n = std::min(disponible, quiere[i]);
+      if (n) std::memcpy(buffer.data() + hacia, b.datos.get() + desde, n);
+      obtuvo[i] = n;
+      listo[i] = true;
+      ++aciertos_bloque;
+      if (b.antic) {
+        b.antic = false;
+        E.antic_usadas.fetch_add(1, std::memory_order_relaxed);
+      }
+      if (b.us_disco >= umbral_us) E.lentas_evitadas.fetch_add(1, std::memory_order_relaxed);
+      E.lista.splice(E.lista.begin(), E.lista, it->second);
+    }
+  }
+
+  bool fue_al_disco = false;
+  if (aciertos_bloque < nb) {
+    // Missing blocks: [pm, um] contiguous, ONE pread, lock not held.
+    uint64_t pm = ultimo + 1, um = 0;
+    for (size_t i = 0; i < nb; ++i) {
+      if (!listo[i]) {
+        pm = std::min(pm, primero + i);
+        um = std::max(um, primero + i);
+      }
+    }
+    const size_t tramo = static_cast<size_t>(um - pm + 1) * kBloqueXio;
+    static thread_local std::vector<uint8_t> tmp;
+    try {
+      if (tmp.size() < 2 * kBloqueXio) tmp.resize(2 * kBloqueXio);
+    } catch (const std::bad_alloc&) {
+      return false;
+    }
+    size_t leidos = 0;
+    bool eof = false;
+    const uint64_t t0 = AhoraUsXio();
+    if (!LeerTramoXio(fh.get(), pm * kBloqueXio, tmp.data(), tramo, &leidos, &eof)) {
+      return false;  // real error: let the usual path answer
+    }
+    const uint64_t us = AhoraUsXio() - t0;
+    fue_al_disco = true;
+    E.bytes_sd.fetch_add(leidos, std::memory_order_relaxed);
+    const uint32_t us_bloque = static_cast<uint32_t>(
+        std::min<uint64_t>(us / static_cast<uint64_t>(um - pm + 1), 0xFFFFFFFFull));
+    for (uint64_t b = pm; b <= um; ++b) {
+      const size_t i = static_cast<size_t>(b - primero);
+      const size_t desde_tmp = static_cast<size_t>(b - pm) * kBloqueXio;
+      const size_t len = desde_tmp < leidos ? std::min(kBloqueXio, leidos - desde_tmp) : 0;
+      size_t desde, hacia;
+      porcion(b, &desde, &hacia);
+      const size_t disponible = desde < len ? len - desde : 0;
+      const size_t n = std::min(disponible, quiere[i]);
+      if (n) std::memcpy(buffer.data() + hacia, tmp.data() + desde_tmp + desde, n);
+      obtuvo[i] = n;
+      listo[i] = true;
+      // A short block is only kept if the 0-byte read confirmed the end of the file.
+      if (len > 0 && (len == kBloqueXio || eof)) {
+        XioGuardar(id, gen, b, tmp.data() + desde_tmp, static_cast<uint32_t>(len), us_bloque, false);
+      }
+    }
+  }
+
+  // Bytes delivered = contiguous from the start of the request.
+  size_t total = 0;
+  for (size_t i = 0; i < nb; ++i) {
+    total += obtuvo[i];
+    if (obtuvo[i] < quiere[i]) break;
+  }
+  *out_bytes_read = total;
+  if (fue_al_disco) {
+    E.fallos.fetch_add(1, std::memory_order_relaxed);
+  } else {
+    E.aciertos.fetch_add(1, std::memory_order_relaxed);
+  }
+  E.bloques_ram.fetch_add(aciertos_bloque, std::memory_order_relaxed);
+  if (aciertos_bloque) {
+    E.bytes_ram.fetch_add(total, std::memory_order_relaxed);
+  }
+  ResumenXio(false);
+  return true;
+}
+
+void ResumenXio(bool forzar) {
+  const int32_t periodo = REXCVAR_GET(xmow_io_cache_resumen_s);
+  if (periodo <= 0 && !forzar) return;
+  EstadoXio& E = Xio();
+  const int64_t ahora_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                               std::chrono::steady_clock::now().time_since_epoch())
+                               .count();
+  int64_t proximo = E.proximo_resumen_ms.load(std::memory_order_relaxed);
+  if (proximo == 0) {
+    E.proximo_resumen_ms.compare_exchange_strong(proximo, ahora_ms + int64_t(periodo) * 1000,
+                                                 std::memory_order_relaxed);
+    return;
+  }
+  if (ahora_ms < proximo || !E.proximo_resumen_ms.compare_exchange_strong(
+                                proximo, ahora_ms + int64_t(periodo) * 1000, std::memory_order_relaxed)) {
+    return;
+  }
+  const EstadisticasBloques s = LeerEstadisticasBloques();
+  const EstadisticasBloques d = [&] {
+    EstadisticasBloques r;
+    r.aciertos = s.aciertos - E.foto.aciertos;
+    r.fallos = s.fallos - E.foto.fallos;
+    r.bytes_ram = s.bytes_ram - E.foto.bytes_ram;
+    r.bytes_sd = s.bytes_sd - E.foto.bytes_sd;
+    r.lentas_evitadas = s.lentas_evitadas - E.foto.lentas_evitadas;
+    r.expulsiones = s.expulsiones - E.foto.expulsiones;
+    return r;
+  }();
+  E.foto = s;
+  const uint64_t lect = d.aciertos + d.fallos;
+  REXLOG_INFO(
+      "[io-cache] last {} s: {} hits / {} misses ({:.0f} %), {:.1f} MB from RAM, {:.1f} MB read from "
+      "the SD, {} slow reads avoided (>= {} ms), {} evictions | total: {} hits / {} misses, {} slow "
+      "reads avoided | cache: {} blocks, {:.1f} MB of {} MB{} | read-ahead: {} asked, {} done, {} used",
+      periodo, d.aciertos, d.fallos, lect ? 100.0 * double(d.aciertos) / double(lect) : 0.0,
+      d.bytes_ram / 1048576.0, d.bytes_sd / 1048576.0, d.lentas_evitadas,
+      REXCVAR_GET(nfsmw_io_aviso_ms), d.expulsiones, s.aciertos, s.fallos, s.lentas_evitadas,
+      s.bloques_vivos, s.bytes_vivos / 1048576.0, s.tope_mb, s.sin_memoria ? " [OFF: no memory]" : "",
+      s.antic_pedidas, s.antic_hechas, s.antic_usadas);
+}
+
+}  // namespace
+
+EstadisticasBloques LeerEstadisticasBloques() {
+  EstadoXio& E = Xio();
+  EstadisticasBloques s;
+  s.aciertos = E.aciertos.load(std::memory_order_relaxed);
+  s.fallos = E.fallos.load(std::memory_order_relaxed);
+  s.bloques_ram = E.bloques_ram.load(std::memory_order_relaxed);
