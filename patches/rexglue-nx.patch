+bool RenderDk::NecesitaCrecer(const ImagenDk& destino, uint32_t ancho_pedido, uint32_t alto_pedido) const {
+  if (!destino.ancho_maximo) {
+    return false;  // made by the old rule: already its largest
+  }
+  return std::min(ancho_pedido, destino.ancho_maximo) > destino.ancho ||
+         std::min(alto_pedido, destino.alto_maximo) > destino.alto;
+}
