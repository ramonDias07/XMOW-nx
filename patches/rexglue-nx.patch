+  // xmow_vsync_relaxado, applied live (switch_perf.cpp has the logic in its nwindowQueueBuffer wrapper), and the
+  // swap-interval diagnostics: logged when the cvar changes and once ~10 s after start.
+  void ControlarVsyncRelajado() {
+    const bool ligado = REXCVAR_GET(xmow_vsync_relaxado);
+    RexSwitchPerfVsyncRelajado(ligado ? 1u : 0u);
+    unsigned actual = 0, cambios = 0, maximo_pedido = 0;
+    RexSwitchPerfIntervaloDiagnostico(&actual, &cambios, &maximo_pedido);
+    if (int(ligado) != vsync_ultimo_ligado_) {
+      vsync_ultimo_ligado_ = int(ligado);
+      REXLOG_INFO("[xmow vsync] relaxed vsync {}, swap interval {}", ligado ? "on" : "off",
+                  ventana_ ? unsigned(ventana_->swap_interval) : actual);
+    }
+    if (++vsync_cuadros_ >= 600) {
+      vsync_cuadros_ = 0;
+      unsigned long long relajados = 0, a_tiempo = 0;
+      RexSwitchPerfVsyncRelajadoContadores(&relajados, &a_tiempo);
+      if (relajados || a_tiempo) {
+        REXLOG_INFO("[xmow vsync] fixed interval: late frames presented at the next vblank={} on time={}", relajados,
+                    a_tiempo);
+      }
+      if (!vsync_diagnostico_hecho_) {
+        vsync_diagnostico_hecho_ = true;
+        REXLOG_INFO(
+            "[xmow vsync] swap interval of the window: {}; changed by something else: {} times; highest interval "
+            "requested through the SDK: {} ({})",
+            actual, cambios, maximo_pedido,
+            (cambios || maximo_pedido > 1) ? "an interval other than the swapchain's own IS in use"
+                                           : "nothing sets a swap interval");
+      }
+    }
+  }
