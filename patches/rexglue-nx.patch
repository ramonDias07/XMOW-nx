+// ---- Texture identity (xmow 1023, xmow_dk_identidad_texturas)
+
+uint64_t RenderDk::HuellaSonda(uint64_t base, uint64_t bytes, uint64_t semilla) const {
+  if (!bytes || base >= kMemoriaFisica) {
+    return semilla;
+  }
+  bytes = std::min<uint64_t>(bytes, kMemoriaFisica - base);
+  const uint8_t* const p = memoria_->TranslatePhysical(uint32_t(base));
+  if (bytes <= 192) {
+    return XXH3_64bits_withSeed(p, size_t(bytes), semilla);
+  }
+  // The first, a middle and the last 64 bytes: another texture put at this address differs in all of them, and a
+  // texture being streamed in changes its first and last ones.
+  uint8_t trozos[192];
+  const uint64_t medio = (bytes / 2) & ~uint64_t(63);
+  const uint64_t ultimo = (bytes - 64) & ~uint64_t(63);
+  std::memcpy(trozos, p, 64);
+  std::memcpy(trozos + 64, p + medio, 64);
+  std::memcpy(trozos + 128, p + ultimo, 64);
+  return XXH3_64bits_withSeed(trozos, sizeof(trozos), semilla);
+}
