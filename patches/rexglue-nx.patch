+      return 4;                                                                    // 16_16(_EXPAND/_FLOAT), 32(_FLOAT)
+    case 26: case 29: case 32: case 34: case 37:  // 16_16_16_16(_EXPAND/_FLOAT), 32_32(_FLOAT)
+      return 8;
+    case 35: case 38:  // 32_32_32_32(_FLOAT)
+      return 16;
+    default:
+      return 0;
+  }
